/*
🧠 Problem: **Two Sum** (LeetCode #1)
🔗 Link: https://leetcode.com/problems/two-sum/
📂 Category: Arrays

💡 Approach:
- Use a **hash map** to track the difference between target and current number.
- Return **indices** if the complement is found.

🕒 Time Complexity: O(n)
🧠 Space Complexity: O(n)
*/

// 🔥 Include necessary libraries
#include <iostream>
#include <unordered_map>
#include <vector>
using namespace std;

// ✨ Function to find two numbers that add up to target
vector<int> twoSum(vector<int>& nums, int target) {
    unordered_map<int, int> hashMap;  // 🔑 Stores numbers and their indices
    for (int i = 0; i < nums.size(); ++i) {
        int complement = target - nums[i];  // 🧩 Find the complement
        if (hashMap.find(complement) != hashMap.end()) {
            return {hashMap[complement], i};  // ✅ Found the solution
        }
        hashMap[nums[i]] = i;  // 📍 Store number with its index
    }
    return {}; // ❌ No solution found
}

// 🎯 Main function to test the solution
int main() {
    vector<int> nums = {2, 7, 11, 15};
    int target = 9;
    vector<int> result = twoSum(nums, target);
    cout << "Indices: " << result[0] << ", " << result[1] << endl;  // 🚀 Output result
    return 0;
}
