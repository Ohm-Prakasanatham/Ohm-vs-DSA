/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    // Function to merge two sorted linked lists
    ListNode* mergeTwoLists(ListNode* l1, ListNode* l2) {
        if (!l1) return l2;
        if (!l2) return l1;

        ListNode* dummy = new ListNode(0); // Dummy node to simplify merging
        ListNode* temp = dummy;

        // Merge the two lists by comparing node values
        while (l1 && l2) {
            if (l1->val < l2->val) {
                temp->next = l1;
                l1 = l1->next;
            } else {
                temp->next = l2;
                l2 = l2->next;
            }
            temp = temp->next;
        }

        // Attach the remaining non-empty list
        if (l1) {
            temp->next = l1;
        } else {
            temp->next = l2;
        }

        return dummy->next; // Return the merged list
    }

    // Function to merge K sorted linked lists using Divide and Conquer
    ListNode* mergeKLists(vector<ListNode*>& lists) {
        if (lists.empty()) return nullptr; // Edge case: No lists

        int n = lists.size();
        while (n > 1) {
            int newSize = (n + 1) / 2; // Calculate new number of lists after merging
            for (int i = 0; i < n / 2; i++) {
                lists[i] = mergeTwoLists(lists[i], lists[i + (n + 1) / 2]);
            }
            n = newSize; // Update the size
        }

        return lists[0]; // Final merged list
    }
};
